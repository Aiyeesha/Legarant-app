# Copier ce fichier en .env pour le développement local (jamais commiter .env)

# Port d'écoute local (Heroku fournit PORT automatiquement en prod)
PORT=3000

# Connexion Postgres (Heroku Connect) — récupérable via `heroku config:get DATABASE_URL`
DATABASE_URL=postgres://user:password@host:5432/dbname

# Désactive la vérification du certificat TLS Postgres si nécessaire (Heroku self-signed).
# Mettre à "true" si vous fournissez un certificat CA valide.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Origines autorisées en CORS, séparées par des virgules. "*" = toutes (déconseillé en prod).
ALLOWED_ORIGINS=*

# Clé API requise (header X-Api-Key) pour les routes d'écriture (POST/PATCH).
# Laisser vide désactive la vérification (déconseillé en prod) — voir README "Sécurité".
API_KEY=

# Fenêtre et plafond du rate limiting global (ms / requêtes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
