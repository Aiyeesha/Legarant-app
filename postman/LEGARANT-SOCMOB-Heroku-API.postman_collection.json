                  "const body = pm.response.json();",
                  "if (body.sfid) pm.environment.set('accountSfid', body.sfid);",
                  "console.log(body.synced ? 'Compte synchronisé, sfid=' + body.sfid : 'Toujours en attente (rejouer la requête) — last_op=' + body.last_op);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/account/{{accountId}}/status",
