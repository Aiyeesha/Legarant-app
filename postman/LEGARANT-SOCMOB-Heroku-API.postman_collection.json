    {
      "name": "Accounts",
      "item": [
        {
          "name": "Créer un compte (POST /account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 créé ou 409 déjà existant', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('axgAccountId', body.account.axg_account_id__c);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AXG SOCMOB Test GmbH\",\n  \"externalId\": \"{{axgAccountId}}\",\n  \"phone\": \"+49 30 555000\",\n  \"billingCity\": \"Berlin\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account", "host": ["{{base_url}}"], "path": ["account"] }
          },
          "response": []
        },
        {
          "name": "Modifier un compte (PATCH /account/:externalId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK ou 404 si compte inconnu', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"Phone\": \"+49 30 555111\", \"BillingCity\": \"Hamburg\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/account/{{axgAccountId}}",
              "host": ["{{base_url}}"],
              "path": ["account", "{{axgAccountId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Contacts d'un compte (GET /account/:externalId/contacts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK et tableau', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/account/{{axgAccountId}}/contacts?active=true",
              "host": ["{{base_url}}"],
              "path": ["account", "{{axgAccountId}}", "contacts"],
              "query": [{ "key": "active", "value": "true" }]
            }
          },
          "response": []
        }
