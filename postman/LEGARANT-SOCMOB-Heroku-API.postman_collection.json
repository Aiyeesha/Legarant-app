    { "key": "axgAccountId", "value": "AXG-ACCT-90001" },
    { "key": "axgContactId", "value": "AXG-C-90001" },
    { "key": "axgContractId", "value": "AXG-CTR-90001" },
    { "key": "contactEmail", "value": "test.socmob@example.de" },
    { "key": "pricebookName", "value": "Standard Price Book" }
  ],
