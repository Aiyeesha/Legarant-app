                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accountId', body.account.id);",
                  "  if (body.account.sfid) pm.environment.set('accountSfid', body.account.sfid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AXG SOCMOB Test GmbH\",\n  \"phone\": \"+49 30 555000\",\n  \"billingCity\": \"Berlin\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account", "host": ["{{base_url}}"], "path": ["account"] }
          },
          "response": []
        },
        {
          "name": "Statut de synchronisation (GET /account/:id/status)",
